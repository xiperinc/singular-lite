# Operator-local overrides + secrets (gitignored). Copy to
# .singular-state/config.local.sh in your repo. Highest precedence — wins over
# singular.config.json and singular.config.sh. Never commit secrets.
#
# Example:
# export ANTHROPIC_API_KEY="sk-..."
# export SINGULAR_CLAUDE_L2_MODEL="claude-sonnet-4-6"
# export SINGULAR_CLAUDE_PLANNER_MODEL="claude-opus-4-8"
# export SINGULAR_MAX_CONCURRENT=2      # fixed ceiling; default is auto (machine-sized)
# export SINGULAR_PUSH=0
