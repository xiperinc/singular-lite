{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "singular.orchestration.ctx-rehydrate-manifest.v0",
  "title": "singular Rehydrate Core Manifest",
  "description": "Additive contract for the core durable-source manifest emitted by singular_ctx_rehydrate_manifest and recorded (nested) into the context.strategy_selected event by singular_ctx_rehydrate_event_data. Records which surviving durable artifacts, at which content hashes, a rehydrate run reads from. `authored` is an OPTIONAL additive key (TASK-0063): a payload without it (durable-only) and one carrying it both validate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources"],
  "properties": {
    "schema": { "const": "singular.orchestration.ctx-rehydrate-manifest.v0" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "authored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sources"],
      "properties": {
        "schema": { "const": "singular.orchestration.ctx-rehydrate-authored-manifest.v0" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256", "class", "authoritative"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "class": { "const": "authored-knowledge" },
              "authoritative": { "const": false }
            }
          }
        }
      }
    }
  }
}
