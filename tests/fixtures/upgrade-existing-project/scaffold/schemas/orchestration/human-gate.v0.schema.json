{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "singular.orchestration.human-gate.v0",
  "title": "singular Human Gate Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gateId",
    "node",
    "approvalType",
    "requiredOwner",
    "questions",
    "artifacts",
    "blockedNodes",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schema": { "const": "singular.orchestration.human-gate.v0" },
    "gateId": { "type": "string", "minLength": 1 },
    "node": { "type": "string", "minLength": 1 },
    "approvalType": { "type": "string", "minLength": 1 },
    "requiredOwner": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "prompt": { "type": "string", "minLength": 1 },
          "required": { "const": true }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "blockedNodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
